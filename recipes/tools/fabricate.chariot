source/fabricate {
    url: "https://github.com/elysium-os/fabricate.git"
    revision: "main"
    type: "git"
}

tool/fabricate {
    dependencies: [ source/fabricate image/rustup image/clang image/libssl-dev image/pkgconf ]
    configure: <sh>
        rustup default stable
    </sh>
    build: <sh>
        cd $SOURCES_DIR/fabricate
        cargo build \
            --profile release \
            --target-dir $BUILD_DIR
    </sh>
    install: <sh>
        install -D release/fabricate $INSTALL_DIR$PREFIX/bin/fabricate
    </sh>
}
